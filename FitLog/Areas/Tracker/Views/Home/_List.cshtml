@using FitLog.Areas.Tracker.ViewModels.Home
@model List<IndexViewModel>
@{
    var totalCaloriesEaten = Model.Sum(x => x.CaloriesEaten);
    var totalWorkoutCalories = Model.Sum(x => x.WorkoutCalories);
    var totalBalance = Model.Sum(x => x.DailyCalorieBalance);
    var totalSteps = Model.Sum(x => x.Steps);
}

<div class="card shadow-sm border-0" style="border-radius:16px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover fit-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Calories</th>
                        <th>Steps</th>
                        <th>Workout calories</th>
                        <th>Daily calorie balance</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="">
                                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                                <td class="fw-semibold">
                                    @item.CaloriesEaten.ToString("N0")
                                </td>
                                <td>@item.Steps.ToString("N0")</td>
                                <td class="fw-semibold">
                                    @item.WorkoutCalories.ToString("N0")
                                </td>
                                <td class="fw-semibold">
                                    @item.DailyCalorieBalance.ToString("N0")
                                </td>
                                <td class="text-center">
                                    <a asp-area="Tracker"
                                       asp-controller="Home"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-fit-orange"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        <tr class="table-secondary fw-bold">
                            <td class="text-end">Total</td>
                            <td>@totalCaloriesEaten.ToString("N0") kcal</td>
                            <td>@totalSteps.ToString("N0")</td>
                            <td>@totalWorkoutCalories.ToString("N0") kcal</td>
                            <td class="@(totalBalance <= 0 ? "text-success" : "text-danger")"> @totalBalance.ToString("N0") kcal </td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No records found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
